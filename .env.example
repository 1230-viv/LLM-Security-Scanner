# Global
PROJECT_NAME=LLM Security Scanner
ENVIRONMENT=development

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Supabase pooled connection string (Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql+asyncpg://postgres.project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres
API_AUTH_TOKEN=change-me
ENCRYPTION_KEY=
API_RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=INFO

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
